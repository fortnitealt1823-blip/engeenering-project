                        <div style="font-size:9px; color:var(--text-sub);">Cache Hit Rate: 99.4%</div>
                    </div>
                    <div class="db-node-box glass-cyber">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <span style="color:var(--text-sub);">THREAT DEFENSE</span>
                            <span style="color:var(--neon-lime);">ARMED</span>
                        </div>
                        <div style="font-size:14px; color:#fff; font-weight:bold;">Neural Sentinel v2</div>
                        <div style="font-size:9px; color:var(--neon-cyan);">Blocked Packets: <span id="blocked-packets">0</span></div>
                    </div>
