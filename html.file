                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span>New User Registrations Active</span>
                        <input type="checkbox" id="setting-reg" style="width: 18px; height: 18px; accent-color: var(--neon-cyan); cursor: pointer;" onchange="updateSystemSetting('registrationOpen', this.checked)">
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span>User Posting Enabled</span>
                        <input type="checkbox" id="setting-post" style="width: 18px; height: 18px; accent-color: var(--neon-cyan); cursor: pointer;" onchange="updateSystemSetting('postingOpen', this.checked)">
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span>System Maintenance Mode</span>
                        <input type="checkbox" id="setting-maint" style="width: 18px; height: 18px; accent-color: var(--neon-pink); cursor: pointer;" onchange="updateSystemSetting('maintenanceMode', this.checked)">
                    </div>
                    <div class="input-group" style="margin-top: 4px;">
                        <label>Global Matrix Banner Announcement</label>
                        <div style="display: flex; gap: 10px;">
