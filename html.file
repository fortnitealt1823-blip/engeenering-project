                    <div style="display: flex; align-items: center; gap: 16px;">
                        <div class="brand-logo" style="width: 52px; height: 52px; background: linear-gradient(135deg, var(--neon-amber), var(--neon-pink)); font-size: 22px; color: #fff;">🛡️</div>
                        <div>
                            <h3 style="font-family: 'Orbitron', sans-serif; font-size: 13px; color: var(--neon-amber); text-transform: uppercase; letter-spacing: 2px; font-weight: 900;">Sovereign Owner Master Vault</h3>
                            <div id="connection-status" style="font-size: 10px; color: var(--neon-lime); font-family: 'JetBrains Mono', monospace; margin-top: 4px;">Status: Connected to Firestore ✓</div>
                        </div>
                    </div>

                    <!-- ADMIN ABUSE & EVENT SCHEDULER SECTION -->
                    <div style="background: rgba(176, 38, 255, 0.06); border: 1px solid rgba(176, 38, 255, 0.35); border-radius: 12px; padding: 22px; display: flex; flex-direction: column; gap: 16px;">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <h4 style="font-family: 'Orbitron', sans-serif; font-size: 11px; color: var(--neon-purple); text-transform: uppercase; letter-spacing: 1.5px;">⚡ Admin Abuse & Crazy Event Center</h4>
                            <span id="admin-abuse-status-badge" class="badge-pill" style="color:var(--neon-pink); border-color:var(--neon-pink);">Status: OFFLINE</span>
                        </div>
                        <p style="font-size: 11px; color: var(--text-sub); line-height: 1.4;">Instantly toggle or schedule crazy custom game lobbies, unrestricted trading sprees, and server-wide event chaos across your other site.</p>
                        
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                            <button class="btn btn-primary" onclick="toggleAdminAbuseNow()" id="btn-toggle-abuse" style="background: linear-gradient(135deg, var(--neon-purple), var(--neon-pink));">🔥 Enable Admin Abuse Now</button>
                            <button class="btn btn-secondary" onclick="openScheduleAbuseModal()">⏰ Schedule Abuse Event</button>
                        </div>

                        <!-- Scheduled Events Table List -->
                        <div style="margin-top: 8px;">
