                            <span style="color:var(--neon-lime);" id="node1-status">● ONLINE</span>
                        </div>
                        <div style="font-size:14px; color:#fff; font-weight:bold;">Firestore v8.10.1</div>
                        <div style="font-size:9px; color:var(--neon-cyan);">Latency: <span id="node1-latency">14ms</span> | Ping: Stable</div>
                    </div>
                    <div class="db-node-box glass-cyber">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <span style="color:var(--text-sub);">REALTIME SYNC</span>
                            <span style="color:var(--neon-lime);" id="node2-status">● STREAMING</span>
                        </div>
                        <div style="font-size:14px; color:#fff; font-weight:bold;">Firebase RTDB</div>
                        <div style="font-size:9px; color:var(--neon-cyan);">Sockets: <span id="active-sockets">128 Active</span></div>
                    </div>
                    <div class="db-node-box glass-cyber">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
