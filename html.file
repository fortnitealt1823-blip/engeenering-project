                <button class="btn btn-secondary" id="modal-btn-ban" onclick="toggleUserStatus('banned')">Toggle Ban</button>
                <button class="btn btn-secondary" id="modal-btn-mute" onclick="toggleUserStatus('muted')">Toggle Mute</button>
                <button class="btn btn-danger" onclick="deleteAccountModal()">Delete Account</button>
