<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ADMIN PANEL</title>
    <!-- Firebase SDK v8 CDN -->
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-auth.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-firestore.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-database.js"></script>
    <!-- Chart.js for Realistic Live Telemetry Graphs -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap');

        :root {
            --neon-cyan: #00f0ff;
            --neon-purple: #b026ff;
            --neon-pink: #ff007f;
            --neon-lime: #39ff14;
            --neon-amber: #ffb703;
            --bg-void: #010409;
            --bg-deep: #060913;
            --bg-card: rgba(8, 14, 30, 0.92);
            --bg-input: rgba(14, 22, 40, 0.85);
            --border-cyber: rgba(0, 240, 255, 0.25);
            --border-glow: rgba(0, 240, 255, 0.6);
            --text-main: #f8fafc;
            --text-sub: #8892b0;
            --radius-cyber: 14px;
            --radius-lg: 22px;
            --shadow-cyber: 0 0 35px -5px rgba(0, 240, 255, 0.2);
            --shadow-intense: 0 0 50px -5px rgba(176, 38, 255, 0.3);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-void);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow-x: hidden;
        }

        /* Database Grid Background Matrix */
        body::before {
            content: "";
            position: fixed; inset: 0;
            background-image: 
                linear-gradient(to right, rgba(0, 240, 255, 0.025) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(0, 240, 255, 0.025) 1px, transparent 1px);
            background-size: 30px 30px;
            z-index: -1;
        }

        /* --- IMMERSIVE LOADING SCREEN --- */
        #loading-screen {
            position: fixed; inset: 0; background: var(--bg-void); z-index: 999999;
            display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 24px;
            font-family: 'Orbitron', sans-serif; transition: opacity 0.5s ease;
        }
        .loader-core {
            width: 75px; height: 75px; border: 3px solid rgba(0,240,255,0.15); border-top: 3px solid var(--neon-cyan);
            border-radius: 50%; animation: spinLoader 0.9s linear infinite; box-shadow: 0 0 25px rgba(0,240,255,0.35);
        }
        @keyframes spinLoader { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .loader-text { color: var(--neon-cyan); font-size: 12px; letter-spacing: 3px; text-transform: uppercase; font-weight: 700; }
        .loader-bar-track { width: 260px; height: 3px; background: rgba(255,255,255,0.06); border-radius: 4px; overflow: hidden; }
        .loader-bar-fill { height: 100%; width: 0%; background: linear-gradient(90deg, var(--neon-cyan), var(--neon-purple)); transition: width 0.15s ease; }

        .container {
            width: 100%; max-width: 1780px; min-height: 100vh;
            display: flex; flex-direction: column; padding: 20px; gap: 16px;
        }

        .glass-cyber {
            background: var(--bg-card);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--border-cyber);
            border-radius: var(--radius-cyber);
            box-shadow: var(--shadow-cyber);
        }

        #login-screen {
            display: flex; justify-content: center; align-items: center; flex: 1;
        }

        .auth-card {
            width: 100%; max-width: 480px; padding: 48px;
            display: flex; flex-direction: column; gap: 22px;
            box-shadow: var(--shadow-intense);
            border: 1px solid rgba(176, 38, 255, 0.4);
            position: relative; overflow: hidden;
        }

        .auth-card::after {
            content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 3px;
            background: linear-gradient(90deg, var(--neon-cyan), var(--neon-purple), var(--neon-pink));
        }

        .auth-card h1 {
            font-family: 'Orbitron', sans-serif; font-size: 24px; font-weight: 900;
            text-align: center; letter-spacing: 1.5px;
            background: linear-gradient(135deg, #fff 30%, var(--neon-cyan));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            text-transform: uppercase;
        }

        .auth-card p {
            text-align: center; color: var(--text-sub); font-size: 11px;
            letter-spacing: 1px; margin-top: -10px; text-transform: uppercase;
        }

        .input-group { display: flex; flex-direction: column; gap: 6px; }
        .input-group label {
            font-family: 'Orbitron', sans-serif; font-size: 9px; font-weight: 700;
            color: var(--neon-cyan); text-transform: uppercase; letter-spacing: 1.5px;
        }

        .input {
            width: 100%; padding: 13px 16px; background: var(--bg-input);
            border: 1px solid rgba(0, 240, 255, 0.2); border-radius: 10px;
            color: #fff; outline: none; font-size: 13px; font-family: inherit;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .input:focus {
            border-color: var(--neon-cyan);
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.35);
            background: rgba(14, 22, 40, 0.98);
        }

        .btn {
            padding: 13px 20px; border: none; border-radius: 10px;
            font-family: 'Orbitron', sans-serif; font-weight: 700; cursor: pointer;
            text-transform: uppercase; letter-spacing: 1.5px; font-size: 10px;
            transition: all 0.25s ease; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        }
        .btn:active { transform: scale(0.96); }

        .btn-primary {
            background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple));
            color: #010409; box-shadow: 0 0 25px rgba(0, 240, 255, 0.4); font-weight: 900;
        }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 0 35px rgba(0, 240, 255, 0.7); filter: brightness(1.1); }

        .btn-danger {
            background: rgba(255, 0, 127, 0.12); color: var(--neon-pink); border: 1px solid rgba(255, 0, 127, 0.35);
        }
        .btn-danger:hover { background: var(--neon-pink); color: #fff; box-shadow: 0 0 20px rgba(255, 0, 127, 0.5); }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.03); color: var(--text-main); border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .btn-secondary:hover {
            background: rgba(0, 240, 255, 0.08); border-color: var(--neon-cyan); color: var(--neon-cyan); box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
        }
        .btn-sm { padding: 8px 14px; font-size: 9px; letter-spacing: 1px; }

        #admin-app { display: none; flex-direction: column; flex: 1; gap: 16px; animation: fadeIn 0.4s ease; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

        header {
            display: flex; justify-content: space-between; align-items: center; padding: 16px 28px; flex-wrap: wrap; gap: 14px;
        }
        .brand-area { display: flex; align-items: center; gap: 16px; }
        .brand-logo {
            width: 48px; height: 48px; background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple));
            border-radius: 12px; display: flex; align-items: center; justify-content: center;
            font-family: 'Orbitron', sans-serif; font-weight: 900; font-size: 18px; color: #010409;
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.5);
        }

        .nav-tabs { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 4px; }
        .nav-tab {
            padding: 11px 18px; background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 10px;
            color: var(--text-sub); font-family: 'Orbitron', sans-serif; font-weight: 700;
            font-size: 9px; cursor: pointer; text-transform: uppercase; letter-spacing: 1px;
            white-space: nowrap; transition: all 0.25s;
        }
        .nav-tab:hover { color: #fff; background: rgba(0, 240, 255, 0.05); border-color: rgba(0, 240, 255, 0.3); }
        .nav-tab.active { background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple)); color: #010409; border-color: transparent; box-shadow: 0 0 25px rgba(0, 240, 255, 0.5); font-weight: 900; }

        .tab-pane { display: none; flex-direction: column; gap: 16px; flex: 1; }
        .tab-pane.active { display: flex; }

        /* --- REALISTIC DATABASE & ANALYTICS WIDGETS --- */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; }
        .stat-card {
            padding: 22px; display: flex; flex-direction: column; gap: 6px; position: relative; overflow: hidden;
            transition: transform 0.25s, border-color 0.25s;
        }
        .stat-card:hover { transform: translateY(-2px); border-color: var(--neon-cyan); box-shadow: 0 0 30px rgba(0, 240, 255, 0.3); }
        .stat-card .val { font-family: 'Orbitron', sans-serif; font-size: 28px; font-weight: 900; color: var(--neon-cyan); letter-spacing: -1px; }
        .stat-card .lbl { font-family: 'Orbitron', sans-serif; font-size: 8px; color: var(--text-sub); text-transform: uppercase; font-weight: 700; letter-spacing: 1.5px; }

        /* Database Node Cluster Metrics */
        .db-status-bar {
            display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px;
        }
        @media(max-width: 1200px) { .db-status-bar { grid-template-columns: repeat(2, 1fr); } }
        
        .db-node-box {
            padding: 18px 22px; display: flex; flex-direction: column; gap: 8px;
            background: linear-gradient(135deg, rgba(8,14,30,0.95), rgba(4,8,18,0.98));
            border-left: 3px solid var(--neon-cyan);
            font-family: 'JetBrains Mono', monospace; font-size: 11px;
        }

        .data-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 12px; font-family: 'JetBrains Mono', monospace; }
        .data-table th, .data-table td { padding: 14px 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
        .data-table th { 
            font-family: 'Orbitron', sans-serif; color: var(--neon-cyan); font-size: 8px; 
            text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700; background: rgba(0, 240, 255, 0.03);
        }
        .data-table tr:hover td { background: rgba(0, 240, 255, 0.02); }
        .table-container { overflow-x: auto; max-height: 520px; overflow-y: auto; }

        .terminal {
            background: #000205; border: 1px solid rgba(0, 240, 255, 0.2); border-radius: 12px; padding: 16px;
            font-family: 'JetBrains Mono', monospace; font-size: 11px; height: 130px; overflow-y: auto;
            color: var(--neon-lime); display: flex; flex-direction: column; gap: 5px; box-shadow: inset 0 2px 15px rgba(0,0,0,0.95);
        }

        .modal-overlay {
            position: fixed; inset: 0; background: rgba(1, 4, 9, 0.88);
            display: none; justify-content: center; align-items: center; z-index: 1000; padding: 20px;
            backdrop-filter: blur(16px); animation: fadeIn 0.2s ease;
        }
        .modal {
            background: var(--bg-deep); border: 1px solid var(--border-cyber); border-radius: var(--radius-lg);
            width: 100%; max-width: 680px; padding: 36px; display: flex; flex-direction: column; gap: 20px;
            max-height: 90vh; overflow-y: auto; box-shadow: 0 0 60px rgba(0, 240, 255, 0.25);
        }

        .toast {
            position: fixed; bottom: 25px; right: 25px; background: #080e1e; border: 1px solid var(--neon-cyan);
            padding: 14px 24px; border-radius: 12px; font-size: 11px; font-weight: 700; z-index: 2000;
            box-shadow: 0 0 35px rgba(0, 240, 255, 0.35); animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex; align-items: center; gap: 10px; color: #fff; font-family: 'Orbitron', sans-serif; letter-spacing: 0.5px;
        }
        @keyframes slideUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

        .badge-pill {
            padding: 4px 12px; background: rgba(0, 240, 255, 0.08); border: 1px solid rgba(0, 240, 255, 0.3);
            border-radius: 16px; color: var(--neon-cyan); font-family: 'Orbitron', sans-serif; font-size: 8px;
            font-weight: 700; text-transform: uppercase; letter-spacing: 1px;
        }

        /* --- GLOBAL CHAT STYLING --- */
        .chat-container-box {
            display: flex; flex-direction: column; height: 500px; border-radius: 12px;
            overflow: hidden; border: 1px solid var(--border-cyber); background-color: var(--bg-deep);
        }
        .chat-messages-scroll {
            flex: 1; padding: 20px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px;
        }
        .chat-msg-card {
            background: rgba(14, 22, 40, 0.55); padding: 12px 16px; border-radius: 10px;
            position: relative; max-width: 85%; border-left: 3px solid var(--neon-cyan);
            border: 1px solid rgba(0, 240, 255, 0.12); animation: fadeInMsg 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes fadeInMsg { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
        .chat-msg-sender {
            font-family: 'Orbitron', sans-serif; font-weight: 700; color: var(--neon-cyan);
            font-size: 9px; margin-bottom: 3px; letter-spacing: 1px; text-transform: uppercase;
        }
        .chat-msg-text { font-size: 12px; word-break: break-word; color: var(--text-main); line-height: 1.4; font-family: 'JetBrains Mono', monospace; }
        .chat-msg-quote {
            font-size: 10px; background: rgba(0, 240, 255, 0.04); padding: 5px 10px;
            border-left: 2px solid var(--neon-purple); margin-bottom: 6px; border-radius: 4px; color: var(--text-sub);
        }
        .chat-reply-trigger {
            background: transparent; color: var(--text-sub); font-size: 9px; padding: 2px 0;
            margin-top: 6px; cursor: pointer; border: none; font-family: 'Orbitron', sans-serif; text-transform: uppercase; letter-spacing: 1px;
        }
        .chat-reply-trigger:hover { color: var(--neon-cyan); }
        .chat-reply-banner {
            background: rgba(8, 14, 30, 0.95); padding: 10px 18px; font-size: 11px;
            display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-cyber);
        }
        .chat-reply-banner span { color: var(--neon-cyan); font-family: 'Orbitron', sans-serif; font-size: 9px; }
        .chat-input-bar {
            display: flex; padding: 14px; background: var(--bg-card); border-top: 1px solid var(--border-cyber); gap: 12px;
        }

        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
        @media(max-width: 1100px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <!-- IMMERSIVE LOADING SCREEN -->
    <div id="loading-screen">
        <div class="loader-core"></div>
        <div class="loader-text" id="loader-status-text">Mounting Quantum Database...</div>
        <div class="loader-bar-track">
            <div class="loader-bar-fill" id="loader-progress-bar"></div>
        </div>
    </div>

    <!-- Music & SFX Audio Elements -->
    <audio id="bg-audio" loop preload="auto">
        <source src="https://vgmsite.com/soundtracks/fortnite-battle-royale-ost/jvxrqhzhkq/OG%20Classic%20-%20Lobby%20Music.mp3" type="audio/mpeg">
    </audio>
    <audio id="click-sfx" preload="auto">
        <source src="https://actions.google.com/sounds/v1/ui/button_click.ogg" type="audio/ogg">
    </audio>

    <!-- SCREEN 1: UPDATE ANIMATION OVERLAY (Spinning Quantum Animation) -->
    <div id="update-screen" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: radial-gradient(circle at center, #051937 0%, #010409 100%); color: #ffffff; z-index: 99999; text-align: center; padding-top: 20vh; box-sizing: border-box; backdrop-filter: blur(20px);">
        <div class="glass-cyber" style="max-width: 580px; margin: 0 auto; padding: 44px; border-color: rgba(0, 240, 255, 0.4); box-shadow: 0 0 70px rgba(0, 240, 255, 0.3);">
            <div class="loader-core" style="width: 72px; height: 72px; margin: 0 auto 18px auto; border-top-color: var(--neon-lime); animation: spinUpdateAnim 0.7s linear infinite;"></div>
            <style>
                @keyframes spinUpdateAnim { 0% { transform: rotate(0deg) scale(1); } 50% { transform: rotate(180deg) scale(1.1); } 100% { transform: rotate(360deg) scale(1); } }
            </style>
            <h1 style="color: var(--neon-lime); font-size: 1.8rem; margin-bottom: 10px; font-family: 'Orbitron', sans-serif; letter-spacing: 2px;">SYSTEM UPDATE IN PROGRESS</h1>
            <p style="color: var(--text-sub); font-size: 12px; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 6px;">Applying quantum patch sequence across client nodes. Please stand by...</p>
            
            <div class="loader-bar-track" style="width: 100%; max-width: 380px; margin: 20px auto;">
                <div class="loader-bar-fill" style="width: 90%; background: linear-gradient(90deg, var(--neon-lime), var(--neon-cyan)); animation: pulseUpdateBar 1.2s infinite alternate;"></div>
            </div>
            <style>
                @keyframes pulseUpdateBar { 0% { width: 20%; } 100% { width: 100%; } }
            </style>

            <p style="font-size: 11px; color: var(--text-main); margin-bottom: 22px;">Enter Master Password (<span style="color: var(--neon-lime);">IDK</span>) to bypass update screen:</p>
            
            <div style="display: flex; flex-direction: column; gap: 14px; align-items: center;">
                <input type="password" id="update-password-input" class="input" style="width: 100%; max-width: 340px; text-align: center; letter-spacing: 3px;" placeholder="ENTER PASS">
                <button class="btn btn-primary" onclick="handleUnlockAttempt('update')" style="width: 100%; max-width: 340px; background: linear-gradient(135deg, var(--neon-lime), var(--neon-cyan)); color:#010409;">Bypass Update Screen</button>
            </div>
            <div id="update-error-msg" style="color: var(--neon-pink); margin-top: 14px; display: none; font-size: 10px; font-family: 'Orbitron', sans-serif; letter-spacing: 1px;">ACCESS DENIED: INVALID MASTER KEY</div>
        </div>
    </div>

    <!-- SCREEN 2: LOCKDOWN OVERLAY (Pulsing Crimson/Pink Alert Animation) -->
    <div id="lockdown-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: radial-gradient(circle at center, #290b1a 0%, #010409 100%); color: #ffffff; z-index: 99999; text-align: center; padding-top: 20vh; box-sizing: border-box; backdrop-filter: blur(20px);">
        <div class="glass-cyber" style="max-width: 580px; margin: 0 auto; padding: 44px; border-color: rgba(255, 0, 127, 0.6); box-shadow: 0 0 80px rgba(255, 0, 127, 0.35); animation: pulseLockdownCard 1.5s ease-in-out infinite alternate;">
            <style>
                @keyframes pulseLockdownCard { 0% { box-shadow: 0 0 40px rgba(255, 0, 127, 0.2); } 100% { box-shadow: 0 0 90px rgba(255, 0, 127, 0.6); } }
            </style>
            <div style="width: 68px; height: 68px; border: 3px solid rgba(255,0,127,0.2); border-top: 3px solid var(--neon-pink); border-radius: 50%; margin: 0 auto 18px auto; animation: spinLockdown 1.2s cubic-bezier(0.68, -0.55, 0.265, 1.55) infinite;"></div>
            <style>
                @keyframes spinLockdown { 0% { transform: rotate(0deg); } 100% { transform: rotate(-360deg); } }
            </style>
            <h1 style="color: var(--neon-pink); font-size: 1.8rem; margin-bottom: 10px; font-family: 'Orbitron', sans-serif; letter-spacing: 2px;">EMERGENCY LOCKDOWN ACTIVE</h1>
            <p style="color: var(--text-sub); font-size: 12px; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 6px;">All client connections have been securely restricted by system command.</p>
            
            <div class="loader-bar-track" style="width: 100%; max-width: 380px; margin: 20px auto;">
                <div class="loader-bar-fill" style="width: 100%; background: linear-gradient(90deg, var(--neon-pink), var(--neon-amber));"></div>
            </div>

            <p style="font-size: 11px; color: var(--text-main); margin-bottom: 22px;">Enter Master Password (<span style="color: var(--neon-pink);">IDK</span>) to lift lockdown:</p>
            
            <div style="display: flex; flex-direction: column; gap: 14px; align-items: center;">
                <input type="password" id="lockdown-password-input" class="input" style="width: 100%; max-width: 340px; text-align: center; letter-spacing: 3px;" placeholder="ENTER pass">
                <button class="btn btn-danger" onclick="handleUnlockAttempt('lockdown')" style="width: 100%; max-width: 340px;">Lift Lockdown & Enter</button>
            </div>
            <div id="lockdown-error-msg" style="color: var(--neon-pink); margin-top: 14px; display: none; font-size: 10px; font-family: 'Orbitron', sans-serif; letter-spacing: 1px;">ACCESS DENIED: INVALID MASTER KEY</div>
        </div>
    </div>

    <!-- ADMIN ABUSE BANNER (Appears globally when Admin Abuse is triggered) -->
    <div id="admin-abuse-global-banner" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; background: linear-gradient(90deg, var(--neon-purple), var(--neon-pink), var(--neon-amber)); color: #010409; text-align: center; padding: 10px; font-family: 'Orbitron', sans-serif; font-size: 11px; font-weight: 900; z-index: 99998; letter-spacing: 2px; box-shadow: 0 0 30px rgba(255,0,127,0.6);">
        ⚡ CRAZY ADMIN ABUSE EVENT ACTIVE: CUSTOM GAMES, UNRESTRICTED TRADING, & MASSIVE MULTIPLIERS ONLINE! ⚡
    </div>

    <div class="container">
        <!-- Login Screen -->
        <div id="login-screen">
            <div class="auth-card glass-cyber">
                <div style="display: flex; justify-content: center; margin-bottom: -4px;">
                    <div class="brand-logo" style="width: 64px; height: 64px; font-size: 24px;">SS</div>
                </div>
                <h1>OP Admin Panel</h1>
                <p>Database Kernel v4.8</p>
                
                <div class="input-group">
                    <label>Admin Handle</label>
                    <input type="text" id="login-user" class="input" placeholder="Username">
                </div>
                <div class="input-group">
                    <label>Access Password</label>
                    <input type="password" id="login-pass" class="input" placeholder="••••••••••••">
                </div>
                <button class="btn btn-primary" onclick="handleLogin()" style="margin-top: 4px;">Initialize Session</button>
            </div>
        </div>

        <!-- Dashboard App -->
        <div id="admin-app">
            <header class="glass-cyber">
                <div class="brand-area">
                    <div class="brand-logo">SS</div>
                    <div>
                        <h2 style="font-family: 'Orbitron', sans-serif; font-size: 15px; font-weight: 900; letter-spacing: 0.5px;">DATABASE KERNEL</h2>
                        <span id="current-admin-badge" style="font-family: 'Orbitron', sans-serif; font-size: 8px; color: var(--neon-cyan); text-transform: uppercase; font-weight: 700; letter-spacing: 1px;"></span>
                    </div>
                </div>
                <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                    <select id="music-track-select" class="input" style="padding: 7px 10px; font-size: 8px; font-family: 'Orbitron', sans-serif; width: 130px;" onchange="changeMusicTrack(this.value)">
                        <option value="https://vgmsite.com/soundtracks/fortnite-battle-royale-ost/jvxrqhzhkq/OG%20Classic%20-%20Lobby%20Music.mp3">🎵 Random Shuffle</option>
                        <option value="https://vgmsite.com/soundtracks/synthwave-radio/synthwave_loop.mp3">🎵 Synthwave Void</option>
                        <option value="https://vgmsite.com/soundtracks/cyberpunk-chill/cyber_chill.mp3">🎵 Cybernetic Chill</option>
                    </select>
                    <button class="btn btn-secondary btn-sm" id="music-toggle-btn" onclick="toggleCustomMusic()">🎵 Music: OFF</button>
                    <button class="btn btn-primary btn-sm" onclick="openLiveBroadcastModal()">📡 Broadcast</button>
                    <button class="btn btn-secondary btn-sm" onclick="openPasswordModal()">🔒 Pass</button>
                    <button class="btn btn-secondary btn-sm" onclick="openAiTerminalTab()">🤖 AI DEC.</button>
                    <button class="btn btn-danger btn-sm" onclick="handleLogout()">Disconnect</button>
                </div>
            </header>

            <div class="nav-tabs">
                <button class="nav-tab active" onclick="switchTab('stats')">Database & Analytics Hub</button>
                <button class="nav-tab" onclick="switchTab('users')">User Directory</button>
                <button class="nav-tab" onclick="switchTab('posts')">Network Feeds</button>
                <button class="nav-tab" onclick="switchTab('chat')">Global Chat</button>
                <button class="nav-tab" onclick="switchTab('stream')">Live Broadcasting</button>
                <button class="nav-tab" onclick="switchTab('ai')">AI Settings</button>
                <button class="nav-tab" onclick="switchTab('badges')">Badges & Ranks</button>
                <button class="nav-tab" onclick="switchTab('promos')">Voucher Codes</button>
                <button class="nav-tab" onclick="switchTab('reports')">Report Tickets</button>
                <button class="nav-tab" onclick="switchTab('settings')">Global Settings</button>
                <button class="nav-tab" id="tab-owner-btn" onclick="switchTab('owner')" style="display:none; color: var(--neon-amber); border-color: rgba(255,183,3,0.4);">Owner Vault</button>
            </div>

            <!-- TAB: STATS / ENHANCED FUTURISTIC ANALYTICS HUB -->
