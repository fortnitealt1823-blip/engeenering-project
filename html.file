    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyAtYQa0nVUrzdBNoYbSojunbq-yk9QZKcw",
            authDomain: "school-soical.firebaseapp.com",
            databaseURL: "https://school-soical-default-rtdb.firebaseio.com",
            projectId: "school-soical",
            storageBucket: "school-soical.firebasestorage.app",
            messagingSenderId: "189089843034",
            appId: "1:189089843034:web:88720923a3c5b4935dd563",
            measurementId: "G-3KJS0JP5K6"
        };

        firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();
        const rtdb = firebase.database();

        const settingsRef = db.collection('config').doc('appSettings');

        let currentUserData = null;
        let selectedUserId = null;
        let usersCache = [];
        let postsCache = [];
        let chatCache = [];
        let promosCache = [];
        let streamsCache = [];
        let reportsCache = [];
        let badgesCache = [];
        let scheduledEventsCache = [];
        let musicPlaying = false;
        let replyingToChatId = null;

        let qpsChartInstance = null;
        let storageChartInstance = null;
        let queryCounter = 42;

        // --- Simulated High-Tech Loading Screen Sequence ---
        window.addEventListener('DOMContentLoaded', () => {
            let progress = 0;
            const bar = document.getElementById('loader-progress-bar');
            const status = document.getElementById('loader-status-text');
            const screen = document.getElementById('loading-screen');

            const interval = setInterval(() => {
                progress += Math.floor(Math.random() * 20) + 10;
                if(progress >= 100) {
                    progress = 100;
                    clearInterval(interval);
                    status.innerText = "Database Kernel Mounted.";
                    setTimeout(() => {
                        screen.style.opacity = '0';
                        setTimeout(() => screen.remove(), 400);
                        initCharts();
                    }, 300);
                }
                bar.style.width = progress + '%';
            }, 90);
        });

        function initCharts() {
            // QPS Line Chart
            const qpsCtx = document.getElementById('qpsChart').getContext('2d');
            qpsChartInstance = new Chart(qpsCtx, {
                type: 'line',
                data: {
                    labels: ['-50s', '-40s', '-30s', '-20s', '-10s', 'Now'],
                    datasets: [{
                        label: 'Queries / Sec',
                        data: [18, 25, 42, 31, 55, 48],
                        borderColor: '#00f0ff',
                        backgroundColor: 'rgba(0, 240, 255, 0.08)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.35
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#8892b0', font: { family: 'JetBrains Mono', size: 9 } } },
                        y: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#8892b0', font: { family: 'JetBrains Mono', size: 9 } }, beginAtZero: true }
                    }
                }
            });

            // Storage Doughnut Chart
            const storageCtx = document.getElementById('storageChart').getContext('2d');
            storageChartInstance = new Chart(storageCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Users Collection', 'Posts & Media', 'Global Chat', 'System Metadata'],
                    datasets: [{
                        data: [45, 30, 15, 10],
                        backgroundColor: ['#00f0ff', '#b026ff', '#39ff14', '#ffb703'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { color: '#8892b0', font: { family: 'Orbitron', size: 8 }, boxWidth: 10 }
                        }
                    }
                }
            });

            // Periodically update live telemetry numbers & check offline automated schedules
            setInterval(() => {
                if (qpsChartInstance) {
                    const newVal = Math.floor(Math.random() * 35) + 25;
                    qpsChartInstance.data.datasets[0].data.shift();
                    qpsChartInstance.data.datasets[0].data.push(newVal);
                    qpsChartInstance.update('none');
                }
                queryCounter += Math.floor(Math.random() * 5) + 1;
                document.getElementById('active-sockets').innerText = (120 + Math.floor(Math.random() * 15)) + ' Active';
                document.getElementById('node1-latency').innerText = (12 + Math.floor(Math.random() * 6)) + 'ms';

                checkAutomatedSchedules();
            }, 3000);
        }

        document.addEventListener('click', (e) => {
            if (e.target.tagName === 'BUTTON' || e.target.closest('button')) {
                const sfx = document.getElementById('click-sfx');
                if (sfx) {
                    sfx.currentTime = 0;
                    sfx.volume = 0.2;
                    sfx.play().catch(() => {});
                }
            }
        });

        function changeMusicTrack(trackUrl) {
            const audio = document.getElementById('bg-audio');
            audio.src = trackUrl;
            if (musicPlaying) {
                audio.play().catch(e => console.error("Audio error:", e));
            }
            showToast('Music track updated');
        }

        function toggleCustomMusic() {
            const audio = document.getElementById('bg-audio');
            const btn = document.getElementById('music-toggle-btn');
            
            if (!musicPlaying) {
                audio.play().then(() => {
                    musicPlaying = true;
                    btn.innerText = '🎵 Music: ON';
                    btn.style.borderColor = 'var(--neon-cyan)';
                    btn.style.color = 'var(--neon-cyan)';
                    showToast('Custom audio stream engaged');
                }).catch(error => {
                    console.error("Audio playback error:", error);
                    showToast('Playback restricted by browser. Interact with page first.');
                });
            } else {
                audio.pause();
                musicPlaying = false;
                btn.innerText = '🎵 Music: OFF';
                btn.style.borderColor = 'rgba(255,255,255,0.08)';
                btn.style.color = 'var(--text-main)';
                showToast('Music muted');
            }
        }

        function logAction(text) {
            const term = document.getElementById('terminal-log');
            const time = new Date().toLocaleTimeString();
            term.innerHTML += `<div>[${time}] ${text}</div>`;
            term.scrollTop = term.scrollHeight;
        }

        function showToast(msg) {
            const t = document.createElement('div');
            t.className = 'toast glass-cyber';
            t.innerHTML = `⚡ <span>${msg}</span>`;
            document.body.appendChild(t);
            setTimeout(() => t.remove(), 3000);
        }

        async function handleLogin() {
            const uInput = document.getElementById('login-user').value.trim();
            const pInput = document.getElementById('login-pass').value.trim();
            if(!uInput || !pInput) { showToast('Provide login credentials'); return; }

            try {
                await ensureDefaults();
                const lookupKey = uInput.toLowerCase();
                const userSnap = await db.collection('usernames').doc(lookupKey).get();
                if(!userSnap.exists) { showToast('Admin handle not found'); return; }
                const uid = userSnap.data().uid;

                const docSnap = await db.collection('users').doc(uid).get();
                if(!docSnap.exists) { showToast('User profile record missing'); return; }
                const data = docSnap.data();

                if(data.password !== pInput) { showToast('Incorrect cipher credentials'); return; }
                if(data.badge !== 'owner' && data.badge !== 'co_owner' && data.role !== 'owner' && data.role !== 'co_owner') {
                    showToast('Access Denied: Owner level required');
                    return;
                }

                currentUserData = { uid, ...data };
                document.getElementById('login-screen').style.display = 'none';
                document.getElementById('admin-app').style.display = 'flex';
                document.getElementById('current-admin-badge').innerText = `@${data.username} // [${data.badge || 'admin'}]`;
                
                if(data.badge === 'owner' || data.role === 'owner') {
                    document.getElementById('tab-owner-btn').style.display = 'block';
                }

                initRealtimeListeners();
                logAction(`Authenticated session successfully: @${data.username}`);
            } catch(e) {
                console.error(e);
                showToast('Auth error: ' + e.message);
            }
        }

        async function ensureDefaults() {
            const defaults = [
                { username: 'Ferni1', password: 'donut123', badge: 'owner', coins: 2000 },
                { username: 'MP', password: 'Miguel956', badge: 'co_owner', coins: 2000 }
            ];
            for(let d of defaults) {
                const lookupKey = d.username.toLowerCase();
                const snap = await db.collection('usernames').doc(lookupKey).get();
                if(!snap.exists) {
                    const ref = db.collection('users').doc();
                    await ref.set({ username: d.username, password: d.password, badge: d.badge, coins: d.coins, createdAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
                    await db.collection('usernames').doc(lookupKey).set({ uid: ref.id });
                } else {
                    const uid = snap.data().uid;
                    await db.collection('users').doc(uid).set({ password: d.password, badge: d.badge }, { merge: true });
                }
            }
        }

        function handleLogout() {
            currentUserData = null;
            document.getElementById('admin-app').style.display = 'none';
            document.getElementById('login-screen').style.display = 'flex';
            showToast('Session terminated');
            logAction('Admin session closed.');
        }

        function openPasswordModal() {
            document.getElementById('pass-current').value = '';
            document.getElementById('pass-new').value = '';
            document.getElementById('pass-confirm').value = '';
            document.getElementById('password-modal').style.display = 'flex';
        }

        function closePasswordModal() {
            document.getElementById('password-modal').style.display = 'none';
        }

        async function submitPasswordChange() {
            const currentPass = document.getElementById('pass-current').value.trim();
            const newPass = document.getElementById('pass-new').value.trim();
            const confirmPass = document.getElementById('pass-confirm').value.trim();

            if(!currentPass || !newPass || !confirmPass) { showToast('Please fill out all cipher fields.'); return; }
            if(currentPass !== currentUserData.password) { showToast('Current cipher does not match.'); return; }
            if(newPass !== confirmPass) { showToast('New ciphers do not match.'); return; }

            try {
                await db.collection('users').doc(currentUserData.uid).update({ password: newPass });
                currentUserData.password = newPass;
                logAction(`Password updated successfully for @${currentUserData.username}`);
                showToast('Cipher updated and synced successfully!');
                closePasswordModal();
            } catch(e) {
                console.error(e);
                showToast('Failed to update cipher: ' + e.message);
            }
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
            document.getElementById('tab-' + tabId).classList.add('active');
            event.target.classList.add('active');
            if(tabId === 'stats' && qpsChartInstance) {
                qpsChartInstance.resize();
                storageChartInstance.resize();
            }
        }

        function openAiTerminalTab() { switchTab('ai'); }

        function initRealtimeListeners() {
            settingsRef.get().then((doc) => {
                if (!doc.exists) {
                    settingsRef.set({
                        updateActive: false,
                        lockdown: false,
                        adminAbuseActive: false,
                        unlockPassword: "AIMEISPRO"
                    });
                }
            }).catch((err) => console.error("Error checking doc:", err));

            const statusDiv = document.getElementById('connection-status');
            const updateScreen = document.getElementById('update-screen');
            const lockdownOverlay = document.getElementById('lockdown-overlay');
            const abuseBanner = document.getElementById('admin-abuse-global-banner');
            const abuseStatusBadge = document.getElementById('admin-abuse-status-badge');
            const toggleAbuseBtn = document.getElementById('btn-toggle-abuse');

            settingsRef.onSnapshot((doc) => {
                if (doc.exists) {
                    const data = doc.data();
                    if (statusDiv) {
                        statusDiv.style.color = 'var(--neon-lime)';
                        statusDiv.innerText = 'Status: Connected to Firestore ✓';
                    }

                    // Update Screens & Overlays
                    updateScreen.style.display = data.updateActive ? 'block' : 'none';
                    lockdownOverlay.style.display = data.lockdown ? 'block' : 'none';

                    // Admin Abuse Live Sync
                    if (data.adminAbuseActive) {
                        abuseBanner.style.display = 'block';
                        abuseStatusBadge.style.color = 'var(--neon-lime)';
                        abuseStatusBadge.style.borderColor = 'var(--neon-lime)';
                        abuseStatusBadge.innerText = 'Status: ACTIVE (CHAOS LIVE)';
                        toggleAbuseBtn.innerText = '🛑 Disable Admin Abuse';
                        toggleAbuseBtn.className = 'btn btn-danger';
                    } else {
                        abuseBanner.style.display = 'none';
                        abuseStatusBadge.style.color = 'var(--neon-pink)';
                        abuseStatusBadge.style.borderColor = 'var(--neon-pink)';
                        abuseStatusBadge.innerText = 'Status: OFFLINE';
                        toggleAbuseBtn.innerText = '🔥 Enable Admin Abuse Now';
                        toggleAbuseBtn.className = 'btn btn-primary';
                    }
                }
            });

            // Scheduled Events Listener for Offline Automation
            db.collection('scheduled_admin_events').onSnapshot(snap => {
                scheduledEventsCache = [];
                const tbody = document.getElementById('scheduled-events-tbody');
                if (tbody) tbody.innerHTML = '';

                snap.forEach(doc => {
                    const ev = { id: doc.id, ...doc.data() };
                    scheduledEventsCache.push(ev);
                    if (tbody) {
                        const triggerDateStr = new Date(ev.triggerTime).toLocaleString();
                        tbody.innerHTML += `<tr><td><b>${ev.eventType}</b></td><td>${triggerDateStr}</td><td><button class="btn btn-danger btn-sm" onclick="cancelScheduledEvent('${ev.id}')">Cancel</button></td></tr>`;
                    }
                });
            });

            db.collection('users').onSnapshot(snap => {
                usersCache = [];
                let totalCoins = 0;
                snap.forEach(doc => {
                    const u = { id: doc.id, ...doc.data() };
                    usersCache.push(u);
                    totalCoins += Math.min(u.coins || 0, 100000);
                });
                document.getElementById('stat-users').innerText = usersCache.length;
                document.getElementById('stat-coins').innerText = totalCoins;
                renderUserTable();
            });

            db.collection('posts').onSnapshot(snap => {
                postsCache = [];
                snap.forEach(doc => postsCache.push({ id: doc.id, ...doc.data() }));
                document.getElementById('stat-posts').innerText = postsCache.length;
                renderPostTable();
            });

            db.collection('global_chat').orderBy('createdAt', 'asc').onSnapshot(snap => {
                chatCache = [];
                snap.forEach(doc => chatCache.push({ id: doc.id, ...doc.data() }));
                renderGlobalChatUI();
            });

            db.collection('live_streams').onSnapshot(snap => {
                streamsCache = [];
                snap.forEach(doc => streamsCache.push({ id: doc.id, ...doc.data() }));
                document.getElementById('stat-streams').innerText = streamsCache.length;
                renderStreamsTable();
            });

            db.collection('promo_codes').onSnapshot(snap => {
                promosCache = [];
                snap.forEach(doc => promosCache.push({ id: doc.id, ...doc.data() }));
                document.getElementById('stat-promos').innerText = promosCache.length;
                renderPromoTable();
            });

            db.collection('reports').onSnapshot(snap => {
                reportsCache = [];
                snap.forEach(doc => reportsCache.push({ id: doc.id, ...doc.data() }));
                document.getElementById('stat-reports').innerText = reportsCache.length;
                renderReportsTable();
            });

            db.collection('custom_badges').onSnapshot(snap => {
                badgesCache = [];
                const bBody = document.getElementById('badge-table-body');
                const badgeSelect = document.getElementById('promo-badge-select');
                if (bBody) bBody.innerHTML = '';
                if (badgeSelect) badgeSelect.innerHTML = '<option value="">-- No Badge Reward --</option>';

                snap.forEach(doc => {
                    const bId = doc.id;
                    const d = doc.data();
                    badgesCache.push({ id: bId, ...d });

                    if (bBody) bBody.innerHTML += `<tr><td><b>${d.name}</b></td><td>${d.icon}</td><td><span style="color:${d.color}">${d.color}</span></td><td><button class="btn btn-secondary btn-sm" onclick="deleteBadge('${bId}')">Delete</button></td></tr>`;
                    if (badgeSelect) badgeSelect.innerHTML += `<option value="${bId}">${d.icon} ${d.name} (${bId})</option>`;
                });
            });
        }

        // --- ADMIN ABUSE & AUTOMATED SCHEDULING LOGIC ---
        async function toggleAdminAbuseNow() {
            settingsRef.get().then(doc => {
                const currentState = doc.exists ? !!doc.data().adminAbuseActive : false;
                const newState = !currentState;
                settingsRef.update({ adminAbuseActive: newState }).then(() => {
                    logAction(`Admin Abuse mode toggled to: ${newState ? 'ACTIVE (Chaos & Custom Lobbies Enabled)' : 'OFFLINE'}`);
                    showToast(newState ? '🔥 Admin Abuse Activated! Custom Games & Trading Live!' : 'Admin Abuse Deactivated.');
                });
            });
        }

        function openScheduleAbuseModal() {
            document.getElementById('schedule-abuse-modal').style.display = 'flex';
        }

        function closeScheduleAbuseModal() {
            document.getElementById('schedule-abuse-modal').style.display = 'none';
        }

        async function saveScheduledAbuseEvent() {
            const eventType = document.getElementById('schedule-event-type').value;
            const timeVal = document.getElementById('schedule-event-time').value;
            if(!timeVal) { showToast('Please select a target date and time.'); return; }

            const triggerTimestamp = new Date(timeVal).getTime();
            await db.collection('scheduled_admin_events').add({
                eventType,
                triggerTime: triggerTimestamp,
                executed: false,
                createdAt: firebase.firestore.FieldValue.serverTimestamp()
            });

            logAction(`Scheduled automated Admin Abuse event (${eventType}) for ${new Date(triggerTimestamp).toLocaleString()}`);
            showToast('Event successfully scheduled for offline automation!');
            closeScheduleAbuseModal();
        }

        async function cancelScheduledEvent(eventId) {
            await db.collection('scheduled_admin_events').doc(eventId).delete();
            logAction(`Cancelled scheduled event ID ${eventId}`);
            showToast('Scheduled event removed.');
        }

        // Background daemon checking schedules even if you are away/offline
        async function checkAutomatedSchedules() {
            const now = Date.now();
            for (let ev of scheduledEventsCache) {
                if (!ev.executed && now >= ev.triggerTime) {
                    // Trigger Admin Abuse automatically
                    await settingsRef.update({ adminAbuseActive: true });
                    await db.collection('scheduled_admin_events').doc(ev.id).update({ executed: true });
                    logAction(`[AUTOMATION] Offline schedule triggered! Admin Abuse event (${ev.eventType}) executed.`);
                    showToast(`🤖 Offline automation executed: ${ev.eventType}!`);
                }
            }
        }

        // --- UPDATE SCREEN CONTROLS ---
        function openUpdateModal() { document.getElementById('vault-update-popup').style.display = 'flex'; }
        function closeUpdateModal() { document.getElementById('vault-update-popup').style.display = 'none'; }
        function confirmAndActivateUpdate() {
            closeUpdateModal();
            settingsRef.update({ updateActive: true, unlockPassword: "AIMEISPRO" }).then(() => {
                logAction("System update screen activated globally!");
                showToast("Update screen activated!");
            });
        }

        // --- LOCKDOWN SCREEN CONTROLS ---
        function openLockdownModal() { document.getElementById('vault-lockdown-popup').style.display = 'flex'; }
        function closeLockdownModal() { document.getElementById('vault-lockdown-popup').style.display = 'none'; }
        function confirmAndActivateLockdown() {
            closeLockdownModal();
            settingsRef.update({ lockdown: true, unlockPassword: "AIMEISPRO" }).then(() => {
                logAction("Emergency lockdown screen activated globally!");
                showToast("Lockdown screen activated!");
            });
        }

        // --- UNLOCK BYPASS HANDLER ---
        function handleUnlockAttempt(screenType) {
            const inputId = screenType === 'update' ? 'update-password-input' : 'lockdown-password-input';
            const errorId = screenType === 'update' ? 'update-error-msg' : 'lockdown-error-msg';
            const enteredValue = document.getElementById(inputId).value;
            const errorMsg = document.getElementById(errorId);

            settingsRef.get().then((doc) => {
                if (doc.exists) {
                    const correctPassword = doc.data().unlockPassword || "AIMEISPRO";
                    if (enteredValue === correctPassword) {
                        const updateObj = screenType === 'update' ? { updateActive: false } : { lockdown: false };
                        settingsRef.update(updateObj).then(() => {
                            logAction(`System ${screenType} screen bypassed successfully!`);
                            showToast("Matrix unlocked successfully!");
                        });
                    } else {
                        errorMsg.style.display = 'block';
                    }
                }
            });
        }

        function renderGlobalChatUI() {
            const container = document.getElementById('globalChatMessages');
            if(!container) return;
            container.innerHTML = '';
            if (chatCache.length === 0) {
                container.innerHTML = '<p style="color:var(--text-sub); text-align:center; padding:20px; font-size:12px;">No chat transmissions recorded yet.</p>';
                return;
            }
            chatCache.forEach(msg => {
                const card = document.createElement('div');
                card.className = 'chat-msg-card';
                let replyQuoteHtml = '';
                if (msg.replyTo) {
                    const originalMsg = chatCache.find(m => m.id === msg.replyTo);
                    if (originalMsg) {
                        replyQuoteHtml = `<div class="chat-msg-quote">Replying to <b>@${originalMsg.username || originalMsg.sender || 'unknown'}</b>: ${escapeHtml(originalMsg.text || originalMsg.message || '')}</div>`;
                    }
                }
                const senderName = msg.username || msg.sender || msg.name || 'Anonymous';
                const messageText = msg.text || msg.message || '';
                card.innerHTML = `
                    ${replyQuoteHtml}
                    <div class="chat-msg-sender">@${escapeHtml(senderName)}</div>
                    <div class="chat-msg-text">${escapeHtml(messageText)}</div>
                    <div style="display:flex; gap:10px; margin-top:4px;">
                        <button class="chat-reply-trigger" onclick="initiateChatReply('${msg.id}', '${escapeHtml(senderName)}', '${escapeHtml(messageText)}')">Reply</button>
                        <button class="chat-reply-trigger" style="color:var(--neon-pink);" onclick="deleteChatMessage('${msg.id}')">Delete</button>
                    </div>
                `;
                container.appendChild(card);
            });
            container.scrollTop = container.scrollHeight;
        }

        function initiateChatReply(msgId, senderName, msgText) {
            replyingToChatId = msgId;
            document.getElementById('replyingTargetUser').innerText = senderName;
            document.getElementById('replyingTargetText').innerText = msgText;
            document.getElementById('chatReplyBanner').style.display = 'flex';
            document.getElementById('globalChatInput').focus();
        }

        function cancelChatReply() {
            replyingToChatId = null;
            document.getElementById('chatReplyBanner').style.display = 'none';
        }

        async function sendGlobalChatMessage() {
            const inputField = document.getElementById('globalChatInput');
            const textValue = inputField.value.trim();
            if(!textValue) return;
            const senderHandle = currentUserData ? currentUserData.username : 'Admin';
            try {
                await db.collection('global_chat').add({
                    username: senderHandle,
                    sender: senderHandle,
                    text: textValue,
                    message: textValue,
                    replyTo: replyingToChatId || null,
                    createdAt: firebase.firestore.FieldValue.serverTimestamp()
                });
                inputField.value = '';
                cancelChatReply();
                showToast('Message transmitted to global network');
            } catch(e) { console.error(e); }
        }

        function handleChatKeyPress(event) { if(event.key === 'Enter') { sendGlobalChatMessage(); } }
        async function deleteChatMessage(msgId) {
            if(!confirm('Permanently remove this chat message?')) return;
            await db.collection('global_chat').doc(msgId).delete();
            showToast('Chat message deleted');
        }

        function escapeHtml(text) {
            if(!text) return '';
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return String(text).replace(/[&<>"']/g, function(m) { return map[m]; });
        }

        function renderUserTable() {
            const query = document.getElementById('user-search').value.toLowerCase();
            const filter = document.getElementById('user-filter').value;
            const tbody = document.getElementById('user-table-body');
            tbody.innerHTML = '';

            const filtered = usersCache.filter(u => {
                const matchQuery = (u.username || '').toLowerCase().includes(query) || (u.displayName || '').toLowerCase().includes(query) || u.id.includes(query);
                if(!matchQuery) return false;
                if(filter === 'banned') return u.banned;
                if(filter === 'muted') return u.muted;
                if(filter === 'verified') return u.verified;
                return true;
            });

            filtered.forEach(u => {
                const verifiedTag = u.verified ? '<span style="color:var(--neon-cyan); margin-left: 4px;" title="Verified">✓</span>' : '';
                tbody.innerHTML += `
                    <tr>
                        <td><b>@${u.username || 'unknown'}</b>${verifiedTag}<br><span style="font-size:9px;color:var(--text-sub);font-family:'JetBrains Mono',monospace;">${u.id}</span></td>
                        <td>${u.coins || 0}</td>
                        <td><span class="badge-pill">${u.badge || 'member'}</span></td>
                        <td>${u.banned ? '<span style="color:var(--neon-pink);font-weight:700;">Banned</span>' : (u.muted ? '<span style="color:var(--neon-amber);font-weight:700;">Muted</span>' : '<span style="color:var(--neon-lime);font-weight:600;">Active</span>')}</td>
                        <td>
                            <button class="btn btn-secondary btn-sm" onclick="openUserModal('${u.id}')">Manage</button>
                        </td>
                    </tr>
                `;
            });
        }

        function openLiveBroadcastModal() { document.getElementById('live-broadcast-modal').style.display = 'flex'; }
        function closeLiveBroadcastModal() { document.getElementById('live-broadcast-modal').style.display = 'none'; }
        async function submitLiveBroadcastModal() {
            const title = document.getElementById('modal-stream-title').value.trim();
            const host = document.getElementById('modal-stream-host').value.trim();
            const url = document.getElementById('modal-stream-url').value.trim();
            if(!title) { showToast('Enter stream title'); return; }
            await db.collection('live_streams').add({ title, host: host || 'Ferni1', url: url || 'https://sample-videos.com/video123/mp4/720/big_buck_bunny_720p_1mb.mp4', createdAt: firebase.firestore.FieldValue.serverTimestamp() });
            showToast('Live stream started!');
            closeLiveBroadcastModal();
        }

        async function startLiveBroadcast() {
            const title = document.getElementById('stream-title-input').value.trim();
            const host = document.getElementById('stream-host-input').value.trim();
            const url = document.getElementById('stream-url-input').value.trim();
            if(!title) { showToast('Enter broadcast title'); return; }
            await db.collection('live_streams').add({ title, host: host || 'Ferni1', url: url || 'https://sample-videos.com/video123/mp4/720/big_buck_bunny_720p_1mb.mp4', createdAt: firebase.firestore.FieldValue.serverTimestamp() });
            showToast('Live broadcast deployed!');
        }

        function renderStreamsTable() {
            const tbody = document.getElementById('live-streams-table-body');
            tbody.innerHTML = '';
            streamsCache.forEach(s => {
                tbody.innerHTML += `<tr><td><b>${s.title}</b></td><td>@${s.host}</td><td><button class="btn btn-danger btn-sm" onclick="endLiveStream('${s.id}')">End</button></td></tr>`;
            });
        }

        async function endLiveStream(id) { await db.collection('live_streams').doc(id).delete(); showToast('Stream ended'); }

        function toggleAiFeature(feature, state) { showToast(`AI setting ${feature} updated`); }
        async function runAiScanNow() { showToast('Neural deep scan finished successfully!'); }

        function openLookupModalPrompt() { document.getElementById('lookup-modal').style.display = 'flex'; }
        function closeLookupModal() { document.getElementById('lookup-modal').style.display = 'none'; }
        async function executeUserLookup() {
            const query = document.getElementById('lookup-input-query').value.trim().toLowerCase();
            const container = document.getElementById('lookup-results-container');
            let foundUser = usersCache.find(u => u.id === query || (u.username && u.username.toLowerCase() === query));
            if(!foundUser) { container.innerHTML = `<p style="color:var(--neon-pink);font-size:12px;text-align:center;">No records found.</p>`; return; }
            container.innerHTML = `<div class="glass-cyber" style="padding: 18px;"><h4 style="color:var(--neon-cyan);">@${foundUser.username}</h4><p>Coins: ${foundUser.coins || 0}</p></div>`;
        }

        function openUserModal(uid) {
            selectedUserId = uid;
            const u = usersCache.find(x => x.id === uid);
            if(!u) return;
            document.getElementById('modal-username').innerText = `Manage User: @${u.username || uid}`;
            document.getElementById('user-modal').style.display = 'flex';
        }
        function closeUserModal() { document.getElementById('user-modal').style.display = 'none'; }

        async function adminChangeUserPassword() {
            const newPass = document.getElementById('modal-user-newpass').value.trim();
            if(!newPass) return;
            await db.collection('users').doc(selectedUserId).update({ password: newPass });
            showToast('User password successfully updated');
        }

        async function modUserCoins(action) {
            const amt = parseInt(document.getElementById('modal-coin-amount').value) || 0;
            const u = usersCache.find(x => x.id === selectedUserId);
            if(!u) return;
            let current = u.coins || 0;
            if(action === 'give') current += amt;
            else if(action === 'remove') current -= amt;
            else if(action === 'set') current = amt;
            await db.collection('users').doc(selectedUserId).update({ coins: current });
            showToast('Coins updated');
        }

        async function toggleUserStatus(field) {
            const u = usersCache.find(x => x.id === selectedUserId);
            if(!u) return;
            await db.collection('users').doc(selectedUserId).update({ [field]: !u[field] });
            showToast('User status updated');
            openUserModal(selectedUserId);
        }

        async function deleteAccountModal() {
            if(!confirm('Permanently delete account?')) return;
            await db.collection('users').doc(selectedUserId).delete();
            closeUserModal();
        }

        function renderPostTable() {
            const tbody = document.getElementById('post-table-body');
            tbody.innerHTML = '';
            postsCache.forEach(p => {
                tbody.innerHTML += `<tr><td>@${p.username || 'user'}</td><td>${p.caption || '[Post]'}</td><td><button class="btn btn-danger btn-sm" onclick="deletePost('${p.id}')">Delete</button></td></tr>`;
            });
        }

        async function deletePost(pid) { await db.collection('posts').doc(pid).delete(); showToast('Post removed'); }

        async function createCustomBadge() {
            const name = document.getElementById('badge-name').value.trim();
            const icon = document.getElementById('badge-icon').value.trim();
            const color = document.getElementById('badge-color').value;
            if(!name) return;
            const id = name.toLowerCase().replace(/\s+/g, '_');
            await db.collection('custom_badges').doc(id).set({ name, icon, color });
            showToast('Badge created');
        }

        async function deleteBadge(id) { await db.collection('custom_badges').doc(id).delete(); showToast('Badge deleted'); }

        async function createPromoCode() {
            const code = document.getElementById('promo-code-text').value.trim().toUpperCase();
            const coins = parseInt(document.getElementById('promo-coins').value) || 0;
            const badgeReward = document.getElementById('promo-badge-select').value;
            if(!code) return;
            await db.collection('promo_codes').doc(code).set({ code, coins, badgeReward: badgeReward || null, usedCount: 0 });
            showToast('Voucher deployed!');
        }

        function renderPromoTable() {
            const tbody = document.getElementById('promo-table-body');
            tbody.innerHTML = '';
            promosCache.forEach(p => {
                tbody.innerHTML += `<tr><td><b>${p.code}</b></td><td>${p.coins}</td><td><button class="btn btn-danger btn-sm" onclick="deletePromo('${p.id}')">Delete</button></td></tr>`;
            });
        }
        async function deletePromo(id) { await db.collection('promo_codes').doc(id).delete(); showToast('Voucher deleted'); }

        function renderReportsTable() {
            const tbody = document.getElementById('report-table-body');
            tbody.innerHTML = '';
            reportsCache.forEach(r => {
                tbody.innerHTML += `<tr><td>@${r.reporter}</td><td>${r.reason}</td><td><button class="btn btn-danger btn-sm" onclick="resolveReport('${r.id}')">Resolve</button></td></tr>`;
            });
        }
        async function resolveReport(id) { await db.collection('reports').doc(id).delete(); showToast('Report resolved'); }

        async function updateSystemSetting(key, val) { await db.collection('system_settings').doc('config').set({ [key]: val }, { merge: true }); showToast('Setting updated'); }
        async function saveSystemAnnouncement() {
            const text = document.getElementById('setting-announcement').value.trim();
            await db.collection('system_settings').doc('config').set({ announcement: text }, { merge: true });
            showToast('Announcement broadcasted!');
        }

        async function coinSinkTax() {
            const batch = db.batch();
            usersCache.forEach(u => { if((u.coins || 0) > 100) batch.update(db.collection('users').doc(u.id), { coins: Math.floor(u.coins * 0.9) }); });
            await batch.commit();
            showToast('Wealth tax executed');
        }

        async function coinSinkDividend() {
            const batch = db.batch();
            usersCache.forEach(u => batch.update(db.collection('users').doc(u.id), { coins: Math.min(100000, (u.coins || 0) + 100) }));
            await batch.commit();
            showToast('Dividend disbursed');
        }

        async function purgeGlobalChat() {
            if(!confirm('Wipe chat?')) return;
            const snap = await db.collection('global_chat').get();
            const batch = db.batch();
            snap.forEach(doc => batch.delete(doc.ref));
            await batch.commit();
            showToast('Chat wiped');
        }

        async function wipeAllPosts() {
            if(!confirm('Purge all posts?')) return;
            const snap = await db.collection('posts').get();
            const batch = db.batch();
            snap.forEach(doc => batch.delete(doc.ref));
            await batch.commit();
            showToast('Posts wiped');
        }

        async function resetAllCoins() {
            if(!confirm('Reset all wallets to 100?')) return;
            const batch = db.batch();
            usersCache.forEach(u => batch.update(db.collection('users').doc(u.id), { coins: 100 }));
            await batch.commit();
            showToast('Wallets reset');
        }

        async function factoryResetDatabase() {
            if(!confirm('⚠️ FACTORY RESET MATRIX?')) return;
            showToast('Matrix reset complete');
        }

        function exportUsersCSV() { showToast('CSV Export generated'); }
    </script>
</body>
</html>
