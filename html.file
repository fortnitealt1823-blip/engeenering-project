                            <div class="table-container" style="max-height: 160px; margin-top: 6px;">
                                <table class="data-table">
                                    <thead><tr><th>Event Type</th><th>Trigger Time</th><th>Action</th></tr></thead>
                                    <tbody id="scheduled-events-tbody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- TWO SEPARATE ACTION BOXES FOR UPDATE & LOCKDOWN -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div style="background: rgba(0, 240, 255, 0.04); border: 1px solid rgba(0, 240, 255, 0.25); border-radius: 12px; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; gap: 14px;">
                            <div>
                                <h4 style="font-family: 'Orbitron', sans-serif; font-size: 10px; color: var(--neon-cyan); text-transform: uppercase; letter-spacing: 1.5px;">System Update Trigger</h4>
                                <p style="font-size: 11px; color: var(--text-sub); margin-top: 4px;">Engages the spinning quantum update animation across all connected client nodes.</p>
                            </div>
                            <button class="btn btn-primary" onclick="openUpdateModal()" style="width: 100%;">⚡ Trigger Update Screen</button>
                        </div>
                        <div style="background: rgba(255, 0, 127, 0.04); border: 1px solid rgba(255, 0, 127, 0.25); border-radius: 12px; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; gap: 14px;">
                            <div>
                                <h4 style="font-family: 'Orbitron', sans-serif; font-size: 10px; color: var(--neon-pink); text-transform: uppercase; letter-spacing: 1.5px;">Emergency Lockdown Trigger</h4>
                                <p style="font-size: 11px; color: var(--text-sub); margin-top: 4px;">Engages the pulsing crimson lockdown alert animation across client nodes.</p>
                            </div>
                            <button class="btn btn-danger" onclick="openLockdownModal()" style="width: 100%;">🚨 Trigger Lockdown Screen</button>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <button class="btn btn-secondary" onclick="coinSinkTax()">Apply 10% Wealth Tax (>100 Coins)</button>
                        <button class="btn btn-secondary" onclick="coinSinkDividend()">Execute +100 Coin Dividend</button>
                        <button class="btn btn-secondary" onclick="bulkCoinGivePrompt()">Bulk Distribute Coins</button>
                        <button class="btn btn-danger" onclick="purgeGlobalChat()">Wipe Entire Global Chat</button>
                        <button class="btn btn-danger" onclick="wipeAllPosts()">Purge All Network Posts</button>
